<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="student_subject_view_form" model="ir.ui.view">
        <field name="name">student.subject.view.form</field>
        <field name="model">student.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="max_marks"/>
                            <field name="passing_marks"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="student_subject_view_tree" model="ir.ui.view">
        <field name="name">student.subject.view.tree</field>
        <field name="model">student.subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="max_marks"/>
                <field name="passing_marks"/>
            </list>
        </field>
    </record>

    <record id="student_subject_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.subject</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Student
            </p>
        </field>
    </record>
</odoo>