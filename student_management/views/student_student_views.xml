<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="student_student_view_form" model="ir.ui.view">
        <field name="name">student.student.view.form</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="grade"/>
                            <field name="total"/>
                            <field name="passed"/>
                        </group>
                    </group>
                    <notebook>
                        <page id="subjects" string="Subject Details">
                            <field name="subject_ids" widget="one2many"
                                   context="{'line_ids': subject_ids}">
                                <list editable="bottom">
                                    <field name="subject_id"/>
                                    <field name="marks_obtained"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="student_student_view_tree" model="ir.ui.view">
        <field name="name">student.student.view.tree</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="age"/>
                <field name="grade"/>
                <field name="total"/>
                <field name="passed"/>
            </list>
        </field>
    </record>

    <record id="student_student_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Student
            </p>
        </field>
    </record>
</odoo>