<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="account_reports.filter_info_template">
        <div class="row">
            <div class="row-options">
                <div class="col-12 ">
                    <h3>
                        <b>
                            <t t-if="options.get('partner_ids') != None">
                                Customer:
                                <t t-set="res_partner_value">All</t>
                                <t t-foreach="options['selected_partner_ids']"
                                   t-as="partner_name">
                                    <t t-if="not partner_name_first">,</t>
                                    <t t-set="res_partner_value" t-value="''"/>
                                    <t t-out="partner_name"/>
                                </t>
                                <t t-out="res_partner_value"/>
                            </t>
                            <br/>
                            <t t-if="options.get('partner_ids') != None">
                                <t t-set="res_partner_value">All</t>
                                <t t-foreach="options['selected_partner_ids']"
                                   t-as="partner_name">
                                    <t t-if="not partner_name_first">,</t>
                                    <t t-set="res_partner_value" t-value="''"/>
                                    <t t-out="partner_name"/>
                                </t>
                                <t t-out="res_partner_value"/>
                                :عميل
                            </t>
                        </b>
                    </h3>
                </div>

                <t t-foreach="options.get('partner_ids')" t-as="partner_id">
                    <t t-set="partner"
                       t-value="env['res.partner'].browse(partner_id)"/>
                    <div class="col-12 mb-1">
                        <span>VAT:
                            <t t-esc="partner.vat or 'N/A'"/>
                        </span>
                    </div>
                </t>


                <t t-if="options.get('date') and options['date'].get('string')">
                    <div class="col-12 mb-1">
                        <t t-out="options['date']['string']"/>
                    </div>
                </t>
                <t t-if="options.get('journals')">
                    <div class="col-12 mb-1"
                         name="filter_info_template_journals">
                        Journals:
                        <t t-set="journal_value"
                           t-value="[journal.get('title') for journal in options['journals'] if journal.get('selected')]"/>
                        <t t-if="len(journal_value) == 0">All</t>
                        <t t-else="">
                            <t t-out="', '.join(journal_value)"/>
                        </t>
                    </div>
                </t>
                <t t-if="options.get('analytic_accounts') != None">
                    <div class="col-12 mb-1">
                        Analytic Filter:
                        <t t-set="analytic_account_value">All</t>
                        <t t-foreach="options['selected_analytic_account_names']"
                           t-as="analytic_account_name">
                            <t t-if="not analytic_account_name_first">,</t>
                            <t t-set="analytic_account_value" t-value="''"/>
                            <t t-out="analytic_account_name"/>
                        </t>
                        <t t-out="analytic_account_value"/>
                    </div>
                </t>
                <t t-if="options.get('analytic_accounts_groupby') != None">
                    <div class="col-12 mb-1">
                        Analytic Accounts:
                        <t t-set="analytic_account_groupby_value">All</t>
                        <t t-foreach="options['selected_analytic_account_groupby_names']"
                           t-as="analytic_account_groupby_name">
                            <t t-if="not analytic_account_groupby_name_first">
                                ,
                            </t>
                            <t t-set="analytic_account_groupby_value"
                               t-value="''"/>
                            <t t-out="analytic_account_groupby_name"/>
                        </t>
                        <t t-out="analytic_account_groupby_value"/>
                    </div>
                </t>
                <t t-if="options.get('analytic_plan_groupby') != None">
                    <div class="col-12 mb-1">
                        Analytic Plans:
                        <t t-set="analytic_plan_groupby_value">All</t>
                        <t t-foreach="options['selected_analytic_plan_groupby_names']"
                           t-as="analytic_plan_groupby_name">
                            <t t-if="not analytic_plan_groupby_name_first">,</t>
                            <t t-set="analytic_plan_groupby_value"
                               t-value="''"/>
                            <t t-out="analytic_plan_groupby_name"/>
                        </t>
                        <t t-out="analytic_plan_groupby_value"/>
                    </div>
                </t>
                <t t-if="options.get('partner_categories') != None">
                    <div class="col-12 mb-1">
                        Partner Categories:
                        <t t-set="res_partner_category_value">All</t>
                        <t t-foreach="options['selected_partner_categories']"
                           t-as="partner_category_name">
                            <t t-if="not partner_category_name_first">,</t>
                            <t t-set="res_partner_category_value" t-value="''"/>
                            <t t-out="partner_category_name"/>
                        </t>
                        <t t-out="res_partner_category_value"/>
                    </div>
                </t>
                <t t-if="options.get('available_horizontal_groups') != []">
                    <div class="col-12 mb-1">
                        <t t-call="account_reports.template_horizontal_group_display"/>
                    </div>
                </t>
                <t t-if="options.get('groupby_fields') and any(opt['selected'] for opt in options['groupby_fields'])">
                    <div class="col-12 mb-1">
                        Groupby:
                        <t t-out="' '.join(opt['name'] for opt in options['groupby_fields'] if opt['selected'])"/>
                    </div>
                </t>
                <t t-if="options.get('company_currency')">
                    <div class="col-12 mb-1">
                        Company Currency:
                        <t t-out="options['company_currency']['currency_name']"/>
                    </div>
                </t>
                <div class="col-12 mb-1" name="pdf_options_header">
                    <t t-if="not options.get('closing_entry')">
                        <t t-call="account_reports.filter_extra_options_template"/>
                    </t>
                </div>
            </div>
        </div>
    </template>
    <template id="account_reports.main_template">
        <div class='o_account_reports_body'>
            <div id="warnings_div">
                <div class="alert alert-info text-center mb-0 no_print"
                     t-if="report.filter_show_draft and not options.get('all_entries') and options.get('unposted_in_period')">
                    <span>There are <a action="open_unposted_moves">unposted
                        Journal Entries
                    </a> prior or included in this period
                    </span>
                </div>
                <div class="alert alert-warning text-center mb-0 no_print"
                     t-if="options.get('contains_archived_tag')">
                    <span>Some journal items appear to point to obsolete report
                        lines. <a action="action_open_amls_with_archived_tags">
                            Check them
                        </a> and correct their tax tags if necessary.
                    </span>
                </div>
            </div>
            <div class="o_account_reports_page o_account_reports_no_print">
                <div class="o_account_reports_header print_only">
                    <div>
                        <h2>
                            <strong>
                                <t t-if="report.filter_show_draft and options['all_entries']">
                                    [Draft]
                                </t>
                                <t t-out="report_title"/>
                            </strong>
                        </h2>
                    </div>
                    <div class="row">
                        <div class="col-8 mb-1">
                            <t>Supplier:</t>
                            <t t-if="not options.get('multi_company')">
                                <br/>
                                <t t-out="report_company_name"/>
                            </t>
                            <t t-else="">
                                <br/>Companies:
                                <t t-set="company_value">All</t>
                                <t t-foreach="options['multi_company']"
                                   t-as="c">
                                    <t t-set="company_value" t-value="''"/>
                                    <t t-out="c.get('name')"/>
                                </t>
                                <t t-out="company_value"/>
                            </t>
                            <address class="mb-1"
                                     t-field="env.company.partner_id"
                                     t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            <div class="mb-1">
                                <t t-if="options.get('tax_unit', 'company_only') == 'company_only'">
                                    VAT:
                                    <t t-out="env.company.vat"/>
                                </t>
                                <t t-else="">
                                    VAT:
                                    <t t-out="env['account.tax.unit'].browse(options.get('tax_unit')).vat"/>
                                </t>
                            </div>
                        </div>
                        <div class="col-4">
                            <t t-call="account_reports.filter_info_template"/>
                        </div>
                    </div>
                </div>
                <div class="o_account_reports_summary"/>
                <div class="table-responsive">
                    <table class="o_account_reports_table table-hover">
                        <t t-call="{{report.main_table_header_template}}"/>
                        <tbody>
                            <t t-if="lines">
                                <t t-call="{{report.line_template}}"/>
                            </t>
                        </tbody>
                    </table>
                </div>
                <div class="js_account_report_footnotes"/>
            </div>
        </div>
    </template>
    <template id="partner_ledger_line_border_inherit"
              inherit_id="account_reports.line_template"
              name="Partner Ledger Line Border Update">
        <xpath expr="//tr" position="attributes">
            <attribute name="style">border-bottom: 1px solid black;</attribute>
        </xpath>
    </template>


</odoo>